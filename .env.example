# Copy to .env (repo root) — never commit real secrets.
NODE_ENV=development

# --- Infra (docker compose host ports; chosen to avoid clashing with other local stacks) ---
POSTGRES_USER=rove
POSTGRES_PASSWORD=rove
POSTGRES_DB=rove
POSTGRES_PORT=5442
REDIS_PORT=6389

# --- Backend ---
PORT=3001
DATABASE_URL=postgresql://rove:rove@localhost:5442/rove?schema=public
REDIS_URL=redis://localhost:6389
CORS_ORIGIN=http://localhost:3000

# --- Auth (Phase 2) ---
# Access tokens are JWTs; refresh tokens are opaque random values stored hashed in the database.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-prod-0001
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Seed users (npm run prisma:seed in backend/) — local development placeholders ---
SEED_ADMIN_EMAIL=admin@rove.local
SEED_ADMIN_PASSWORD=Rove-Admin-12345
SEED_CUSTOMER_EMAIL=customer@rove.local
SEED_CUSTOMER_PASSWORD=Rove-Customer-12345
# Shared password for the seeded city managers (manager.blr@rove.local, ...) and station employees (employee.indiranagar@rove.local, ...)
SEED_STAFF_PASSWORD=Rove-Staff-12345

# --- Provider selection: mock until the phase that replaces it ---
OTP_PROVIDER=mock            # real: Phase 9
KYC_PROVIDER=mock            # real: Phase 9
PAYMENT_PROVIDER=mock        # real: Phase 10
NOTIFICATION_PROVIDER=mock   # real: Phase 8+
TELEMETRY_PROVIDER=mock      # simulator: Phase 11, real: Phase 12

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
