# Copy to infra/production.env and fill in. NEVER commit the real file (it is ignored by git).
# Use long random values for every secret, e.g. `openssl rand -base64 36`.

POSTGRES_USER=rove
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rove
REDIS_PASSWORD=change-me

# The public address of the website (browsers' origin), no trailing slash.
CORS_ORIGIN=https://rove.example
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Signs the identity provider's webhook (HMAC-SHA256), and the key trackers send as x-device-key.
KYC_WEBHOOK_SECRET=change-me-to-a-long-random-string
TELEMETRY_INGEST_KEY=change-me-to-a-long-random-string

# Number of reverse proxies in front of the API (your TLS proxy / load balancer = 1).
TRUST_PROXY=1
# The API documentation page is off in production unless you turn it on.
SWAGGER_ENABLED=false

# The API REFUSES to start in production with `mock` for OTP, KYC or payment. Set the real providers here once they exist
# (Phases 9 and 10). Notifications and telemetry may stay `mock` (in-app messages work; trackers can post to /telemetry).
OTP_PROVIDER=mock
KYC_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
TELEMETRY_PROVIDER=mock

# Where the API and website listen on this machine (the proxy forwards here).
API_PORT=3001
WEB_PORT=3000
# How the website's server reaches the API. Baked into the website image at build time.
WEB_API_URL=http://backend:3001/api/v1
