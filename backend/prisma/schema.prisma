// See docs/DATABASE.md for the planned entities. Money fields (later phases) are integer paise.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CITY_MANAGER
  STATION_EMPLOYEE
  CUSTOMER
}

enum VehicleType {
  SCOOTER
  // BIKE, CAR later. Type-specific attributes belong on VehicleModel, not Vehicle.
}

enum StationStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_RIDE
  MAINTENANCE
  OFFLINE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BookingStatus {
  PENDING_PAYMENT // vehicle held for 10 minutes while the customer pays
  CONFIRMED
  IN_RIDE // Phase 5
  RETURNED // Phase 5
  SETTLED // Phase 6
  CANCELLED
  EXPIRED // payment hold ran out
  NO_SHOW // Phase 5
}

enum PaymentPurpose {
  RENTAL_AND_DEPOSIT
  OUTSTANDING // Phase 6
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  SUCCEEDED
  FAILED
}

enum RefundReason {
  CANCELLATION
  DEPOSIT_RETURN // Phase 6
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  // Customers sign in with their phone (OTP): no password, email optional. Staff have both (CHECK in migration).
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  fullName        String
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens RefreshToken[]
  assignments   StaffAssignment[]
  bookings      Booking[]
  kyc           KycRecord?

  @@index([role])
}

// Opaque refresh tokens: only the SHA-256 hash is stored. Rotated on every use.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Defines staff scope. Exactly one of cityId / stationId is set (CHECK constraint in migration).
model StaffAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  cityId    String?  @db.Uuid
  stationId String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  station Station? @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([userId, cityId])
  @@unique([userId, stationId])
  @@index([userId])
  @@index([cityId])
  @@index([stationId])
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  state     String
  // IANA time zone, used for opening hours and (later) late-fee day boundaries.
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stations     Station[]
  assignments  StaffAssignment[]
  pricingPlans PricingPlan[]

  @@unique([name, state])
}

model Station {
  id        String        @id @default(uuid()) @db.Uuid
  cityId    String        @db.Uuid
  name      String
  address   String
  latitude  Float
  longitude Float
  capacity  Int
  // Local opening hours as "HH:mm" in the city time zone; both null = always open.
  opensAt   String?
  closesAt  String?
  status    StationStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  city        City              @relation(fields: [cityId], references: [id], onDelete: Restrict)
  vehicles    Vehicle[]
  assignments StaffAssignment[]
  bookings    Booking[]

  @@unique([cityId, name])
  @@index([cityId])
}

model VehicleModel {
  id                String      @id @default(uuid()) @db.Uuid
  type              VehicleType @default(SCOOTER)
  brand             String
  name              String
  rangeKm           Int
  topSpeedKmh       Int
  batteryCapacityWh Int?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  vehicles     Vehicle[]
  pricingPlans PricingPlan[]

  @@unique([brand, name])
}

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  modelId            String        @db.Uuid
  // Station the vehicle is currently based at. Null while out on a ride (set by Phase 5).
  stationId          String?       @db.Uuid
  // Short internal code painted on the vehicle, e.g. BLR-001.
  code               String        @unique
  registrationNumber String?       @unique
  status             VehicleStatus @default(AVAILABLE)
  batteryPercent     Int?
  odometerKm         Float         @default(0)
  // Set when a vehicle is retired. Retired vehicles are hidden everywhere (soft delete).
  retiredAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  model    VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  station  Station?     @relation(fields: [stationId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([stationId, status])
  @@index([modelId])
}

// Money is integer paise. A plan belongs to a model; cityId null = the default for every city, a city plan overrides it.
// At most one default plan per model (partial unique index in the migration).
model PricingPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  modelId              String   @db.Uuid
  cityId               String?  @db.Uuid
  hourlyRateAmount     Int
  // When set, the rental for any duration is capped at this price (so 24 hours costs the day rate).
  dailyRateAmount      Int?
  includedKmPerHour    Int
  extraKmRateAmount    Int
  graceMinutes         Int      @default(15)
  lateFeePerHourAmount Int
  depositAmount        Int
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  city  City?        @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([modelId, cityId])
  @@index([cityId])
}

// A customer's reservation of one specific vehicle for a time window. Overlaps on a vehicle are impossible (exclusion
// constraint in the migration). The PIN is not stored: it is derived from the booking (see booking-codes.ts).
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  userId          String        @db.Uuid
  vehicleId       String        @db.Uuid
  // Pickup station, copied from the vehicle at booking time.
  stationId       String        @db.Uuid
  status          BookingStatus @default(PENDING_PAYMENT)
  startAt         DateTime
  endAt           DateTime
  hours           Int
  holdExpiresAt   DateTime?
  rentalAmount    Int
  depositAmount   Int
  totalAmount     Int
  // The plan values the customer agreed to (rates, included km, late fee, grace, deposit). Later plan edits never change it.
  pricingSnapshot Json
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  station  Station   @relation(fields: [stationId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([vehicleId, startAt])
  @@index([stationId, startAt])
}

model Payment {
  id             String         @id @default(uuid()) @db.Uuid
  bookingId      String         @db.Uuid
  purpose        PaymentPurpose
  chargeAmount   Int
  status         PaymentStatus  @default(PENDING)
  provider       String
  providerRef    String?
  // Replaying the same key returns the same payment instead of charging twice.
  idempotencyKey String?        @unique
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([bookingId])
}

model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  paymentId    String       @db.Uuid
  refundAmount Int
  status       RefundStatus
  reason       RefundReason
  provider     String
  providerRef  String?
  createdAt    DateTime     @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

// One KYC record per customer. Holds the outcome only: never an identity number (see Security rules).
model KycRecord {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  provider        String
  providerRef     String?
  status          KycStatus
  consentAt       DateTime
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
